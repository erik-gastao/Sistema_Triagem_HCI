# Copie para backend/.env e ajuste conforme necessário.

# ---------- Ollama ----------
# Servidor Ollama local.
OLLAMA_URL=http://localhost:11434

# Modelo usado na triagem. Esta máquina é CPU-only (sem NVIDIA):
#   llama3.2:3b  -> ~8-15s por triagem, ~2GB RAM
#   mistral      -> ~20-40s por triagem, ~4.5GB RAM
OLLAMA_MODEL=llama3.2:3b

# ---------- Backend ----------
# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# Quantos casos validados semelhantes são injetados no prompt (RAG).
N_CASOS_SIMILARES=3

# Modelo de embeddings clínicos em português.
EMBEDDING_MODEL=pucpr/biobertpt-clin

# Caminhos de dados (relativos a backend/).
DB_PATH=./validacao_triagem.db
CHROMA_PATH=./chroma_db
EMBEDDING_CACHE_DIR=./embedding_cache
